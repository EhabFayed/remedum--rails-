<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? "rtl" : "ltr" %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for(:title) %> — <%= t("site.meta.title_suffix") %></title>
  <meta name="description" content="<%= content_for(:description) %>">
  <link rel="alternate" hreflang="<%= I18n.locale %>" href="<%= self_canonical_path %>">
  <link rel="alternate" hreflang="<%= rtl? ? "en" : "ar" %>" href="<%= alt_locale_path %>">
  <link rel="alternate" hreflang="x-default" href="<%= rtl? ? alt_locale_path : self_canonical_path %>">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if rtl? %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800;900&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Archivo:wght@600;700;800&display=swap">
  <% else %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
  <% end %>
  <link rel="stylesheet" href="/assets/css/site.css">
  <%= csrf_meta_tags %>
</head>
<body>
<header class="site-header">
  <div class="site-header__inner">
    <a class="logo" href="<%= locale_path("") %>">
      <span class="logo__mark"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19C5 9 11 4 20 4c0 9-5 15-15 15z"></path><path d="M5 19c3-6 6-9 10-11"></path></svg></span>
      <span class="logo__text"><b><%= t("site.brand") %></b><i class="lat"><%= t("site.brand_sub") %></i></span>
    </a>
    <nav class="nav" aria-label="<%= t("site.actions.main_nav") %>">
      <ul class="nav__list">
        <% SiteHelper::NAV.each do |item| %>
        <li class="nav__item">
          <a class="nav__link<%= " is-active" if content_for(:nav_active).to_s == item[:key] %>" href="<%= locale_path(item[:path]) %>"><%= t("site.nav.#{item[:key]}") %><% if item[:items] %><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg><% end %></a>
          <% if item[:items] %>
          <div class="dropdown">
            <% item[:items].each do |(label_key, sub_path)| %>
            <a href="<%= locale_path(sub_path) %>"><%= t("site.nav.#{label_key}") %></a>
            <% end %>
          </div>
          <% end %>
        </li>
        <% end %>
      </ul>
    </nav>
    <div class="header__actions">
      <a class="btn btn--dark" href="<%= locale_path("medical/quote") %>"><%= t("site.actions.quote") %><span class="btn__circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 17L7 7"></path><path d="M7 14V7h7"></path></svg></span></a>
      <a class="wa-btn" href="<%= whatsapp_url %>" target="_blank" rel="noopener"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2zm4.8 13.9c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.6-.1 1.2z"></path></svg><%= t("site.actions.whatsapp") %></a>
      <a class="lang-pill" href="<%= alt_locale_path %>" lang="<%= rtl? ? "en" : "ar" %>" dir="<%= rtl? ? "ltr" : "rtl" %>"><%= t("site.actions.lang_switch") %></a>
      <button class="burger" aria-label="<%= t("site.actions.menu") %>"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<main>
<%= yield %>
</main>
<footer class="site-footer"><div class="container">
  <div class="site-footer__top">
    <div class="site-footer__about">
      <a class="logo" href="<%= locale_path("") %>">
        <span class="logo__mark"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19C5 9 11 4 20 4c0 9-5 15-15 15z"></path><path d="M5 19c3-6 6-9 10-11"></path></svg></span>
        <span class="logo__text"><b><%= t("site.brand") %></b><i class="lat"><%= t("site.brand_sub") %></i></span>
      </a>
      <p><%= t("site.footer.tagline") %></p>
      <ul>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg><span><%= site_setting("address_#{I18n.locale}", t("site.footer.address")) %></span></li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg><span><span class="lat" dir="ltr"><%= site_setting("contact_phone", "+966 56 201 7170") %></span> — <%= t("site.footer.phone_label") %></span></li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg><span class="lat" dir="ltr"><%= site_setting("contact_email", "sales@beautyrooots.com") %></span></li>
      </ul>
    </div>
    <div class="site-footer__links">
      <h5><%= t("site.footer.quick_links") %></h5>
      <ul>
        <% SiteHelper::FOOTER_LINKS.each do |(label_key, path)| %>
        <li><a href="<%= locale_path(path) %>"><%= t("site.footer.#{label_key}") %></a></li>
        <% end %>
      </ul>
    </div>
    <div style="display:flex;flex-direction:column;gap:12px">
      <a class="cta-box" href="<%= locale_path("medical/quote") %>">
        <span class="tag"><%= t("site.footer.cta1_tag") %></span>
        <strong><%= t("site.footer.cta1_title") %></strong>
        <p><%= t("site.footer.cta1_desc") %></p>
        <i><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 17L7 7"></path><path d="M7 14V7h7"></path></svg></i>
      </a>
      <a class="cta-box cta-box--alt" href="<%= whatsapp_url %>" target="_blank" rel="noopener">
        <span class="tag"><%= t("site.footer.cta2_tag") %></span>
        <strong><%= t("site.footer.cta2_title") %></strong>
        <p><%= t("site.footer.cta2_desc") %></p>
        <i><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2zm4.8 13.9c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.6-.1 1.2z"></path></svg></i>
      </a>
    </div>
  </div>
  <div class="site-footer__bottom">
    <p>© <span data-year>2026</span> <%= t("site.footer.copyright") %> <span class="lat" dir="ltr"><%= site_setting("cr_number", "1010909714") %></span> · <%= t("site.footer.vat") %> <span class="lat" dir="ltr"><%= site_setting("vat_number", "311755763600003") %></span></p>
    <ul>
      <li><a href="<%= locale_path("legal/privacy") %>"><%= t("site.footer.legal_privacy") %></a></li>
      <li><a href="<%= locale_path("legal/terms") %>"><%= t("site.footer.legal_terms") %></a></li>
      <li><a href="<%= locale_path("legal/medical-disclaimer") %>"><%= t("site.footer.legal_disclaimer") %></a></li>
    </ul>
  </div>
</div></footer>
<script src="/assets/js/site.js"></script>
</body>
</html>
