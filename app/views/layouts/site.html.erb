<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? "rtl" : "ltr" %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for(:title) %> — <%= t("site.meta.title_suffix") %></title>
  <meta name="description" content="<%= content_for(:description) %>">
  <link rel="alternate" hreflang="<%= I18n.locale %>" href="<%= self_canonical_path %>">
  <link rel="alternate" hreflang="<%= rtl? ? "en" : "ar" %>" href="<%= alt_locale_path %>">
  <link rel="alternate" hreflang="x-default" href="<%= rtl? ? self_canonical_path : alt_locale_path %>">
  <link rel="icon" href="<%= static_asset("/favicon.svg") %>" type="image/svg+xml">
  <link rel="icon" href="<%= static_asset("/favicon.ico") %>" sizes="32x32">
  <link rel="apple-touch-icon" href="<%= static_asset("/apple-touch-icon.png") %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if rtl? %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800;900&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Archivo:wght@600;700;800&display=swap">
  <% else %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
  <% end %>
  <link rel="stylesheet" href="<%= static_asset("/assets/css/site.css") %>">
  <link rel="stylesheet" href="<%= static_asset("/assets/css/site-footer.css") %>">
  <%= csrf_meta_tags %>
</head>
<body>
<%= render "shared/site_header" %>
<main>
<%= yield %>
</main>
<%= render "shared/site_footer" %>
<%= render "shared/wa_float" %>
<%= render "shared/back_to_top" %>
<script src="<%= static_asset("/assets/js/site-header.js") %>"></script>
<script src="<%= static_asset("/assets/js/site.js") %>"></script>
<script src="<%= static_asset("/assets/js/search.js") %>" defer></script>
</body>
</html>
