<% content_for :title, "مسار جديد" %>
<%= page_header "مسار جديد" do %>
  <a class="btn btn--sm pressable" href="<%= admin_review_tracks_path %>">رجوع</a>
<% end %>
<div class="card" style="max-width:40rem">
  <%= form_with model: [:admin, @track] do |f| %>
    <%= render "admin/shared/errors", record: @track %>
    <%= render "fields", form: f %>
    <%= f.submit "إضافة", class: "btn btn--primary pressable" %>
  <% end %>
</div>
