<%= form_with model: [:admin, product], data: { lang_scope: true } do |f| %>
  <%= render "admin/shared/errors", record: product %>

  <div class="langtabs" data-langtabs role="tablist" aria-label="لغة التحرير">
    <button type="button" class="langtab is-on" data-lang="ar" role="tab" aria-selected="true">العربية</button>
    <button type="button" class="langtab" data-lang="en" role="tab" aria-selected="false">English</button>
  </div>

  <div class="split">
    <div class="card">
      <div data-lang-pane="ar" dir="rtl">
        <div class="field">
          <label class="label">اسم المنتج <span class="req">*</span></label>
          <%= f.text_field :name_ar, class: "inp", placeholder: "ReMedium Fine" %>
        </div>
        <div class="field">
          <label class="label">السطر الوصفي</label>
          <%= f.text_field :subtitle_ar, class: "inp", placeholder: "للخطوط الدقيقة والسطحية" %>
        </div>
        <div class="field">
          <label class="label">مناطق الاستخدام — افصل بينها بفاصلة</label>
          <%= f.text_area :indications_ar, class: "txt", rows: 3, placeholder: "حول العين، خطوط الجبهة، خطوط الرقبة" %>
        </div>
      </div>

      <div data-lang-pane="en" dir="ltr" hidden>
        <div class="field">
          <label class="label">Product name <span class="req">*</span></label>
          <%= f.text_field :name_en, class: "inp" %>
        </div>
        <div class="field">
          <label class="label">Subtitle</label>
          <%= f.text_field :subtitle_en, class: "inp" %>
        </div>
        <div class="field">
          <label class="label">Indications — comma separated</label>
          <%= f.text_area :indications_en, class: "txt", rows: 3 %>
        </div>
      </div>
    </div>

    <aside style="display:flex;flex-direction:column;gap:16px">
      <div class="card">
        <div class="field">
          <label class="label">العلامة</label>
          <%= f.collection_select :brand_id, @brands, :id, :name_ar, { include_blank: "بدون علامة" }, class: "sel" %>
        </div>
        <div class="field">
          <label class="label">الحالة</label>
          <%= f.select :status, [["منشور", "published"], ["مسوّدة", "draft"]], {}, class: "sel" %>
        </div>
        <div class="grid-2">
          <div class="field">
            <label class="label">ثبات النتيجة من (شهر)</label>
            <%= f.number_field :duration_from, class: "inp", min: 0, max: 60 %>
          </div>
          <div class="field">
            <label class="label">إلى (شهر)</label>
            <%= f.number_field :duration_to, class: "inp", min: 0, max: 60 %>
          </div>
        </div>
        <div class="field">
          <label class="label">لون التمييز</label>
          <%= f.text_field :accent_color, class: "inp inp--mono", dir: "ltr", placeholder: "#4FD3A5" %>
          <p class="hint">لون شريط المدة وبطاقة المنتج على الموقع.</p>
        </div>
        <div class="field">
          <label class="label">مسار الصفحة</label>
          <%= f.text_field :page_path, class: "inp inp--mono", dir: "ltr", placeholder: "brands/remedium/fine" %>
        </div>
        <div class="grid-2">
          <div class="field">
            <label class="label">المعرّف (slug)</label>
            <%= f.text_field :slug, class: "inp inp--mono", dir: "ltr" %>
          </div>
          <div class="field">
            <label class="label">الترتيب</label>
            <%= f.number_field :position, class: "inp" %>
          </div>
        </div>
      </div>

      <div class="card">
        <h2 class="card__title" style="margin-bottom:10px">صورة المنتج</h2>
        <%= render "admin/shared/image_picker", form: f, label: "الصورة", hint: "product",
                   url_field: :image_url, width_field: nil, height_field: nil %>
      </div>

      <%= f.submit "حفظ", class: "btn btn--primary btn--full pressable" %>
    </aside>
  </div>
<% end %>
