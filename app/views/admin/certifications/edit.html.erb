<% content_for :title, "تحرير الاعتماد" %>
<%= page_header "تحرير الاعتماد" do %>
  <a class="btn btn--sm pressable" href="<%= admin_certifications_path %>">رجوع</a>
<% end %>
<div class="card" style="max-width:40rem">
  <%= form_with model: [:admin, @certification] do |f| %>
    <%= render "admin/shared/errors", record: @certification %>
    <%= render "fields", form: f %>
    <%= f.submit "حفظ", class: "btn btn--primary pressable" %>
  <% end %>
</div>
