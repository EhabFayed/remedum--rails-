<% content_for :title, "طلب من #{@lead.name}" %>
<%= page_header @lead.name, "#{@lead.source == "quote" ? "طلب عرض سعر" : "رسالة تواصل"} · #{admin_date @lead.created_at}" do %>
  <a class="btn btn--sm pressable" href="<%= admin_leads_path %>">رجوع</a>
<% end %>

<div class="split">
  <div>
    <dl class="deflist">
      <div><dt>الحالة</dt><dd><%= status_pill @lead.status %></dd></div>
      <div><dt>المنشأة</dt><dd><%= @lead.facility.presence || "—" %></dd></div>
      <div><dt>نوع المنشأة</dt><dd><%= @lead.facility_type.presence || "—" %></dd></div>
      <div><dt>المدينة</dt><dd><%= @lead.city.presence || "—" %></dd></div>
      <div><dt>الجوال</dt><dd class="lat" dir="ltr"><%= @lead.phone.presence || "—" %></dd></div>
      <div><dt>البريد</dt><dd class="lat" dir="ltr"><%= @lead.email.presence || "—" %></dd></div>
      <div><dt>المنتجات</dt><dd>
        <% if @lead.products.any? %>
          <div class="taglist"><% @lead.products.each do |p| %><span class="pill pill--off"><%= p %></span><% end %></div>
        <% else %>—<% end %>
      </dd></div>
      <div><dt>الكمية التقديرية</dt><dd><%= @lead.volume.presence || "—" %></dd></div>
      <div><dt>عميل حالي</dt><dd><%= @lead.existing_client ? "نعم" : "لا" %></dd></div>
      <div><dt>يطلب زيارة مندوب</dt><dd><%= @lead.visit_requested ? "نعم" : "لا" %></dd></div>
      <div><dt>أقرّ بالترخيص</dt><dd><%= @lead.eligibility_ack ? "نعم" : "لا" %></dd></div>
      <div><dt>اللغة</dt><dd class="lat"><%= @lead.locale %></dd></div>
      <div><dt>الصفحة المصدر</dt><dd class="lat" dir="ltr" style="font-size:12px"><%= @lead.source_path.presence || "—" %></dd></div>
    </dl>

    <% if @lead.message.present? %>
      <div class="card" style="margin-top:16px">
        <h2 class="card__title" style="margin-bottom:8px">ملاحظات مُرسِل الطلب</h2>
        <p style="font-size:14px;color:var(--muted);white-space:pre-wrap"><%= @lead.message %></p>
      </div>
    <% end %>
  </div>

  <aside style="display:flex;flex-direction:column;gap:16px">
    <div class="card">
      <h2 class="card__title" style="margin-bottom:12px">متابعة الطلب</h2>
      <%= form_with model: [:admin, @lead], method: :patch do |f| %>
        <div class="field">
          <label class="label">الحالة</label>
          <%= f.select :status, Lead::STATUSES.map { |s| [Lead::STATUS_LABELS[s], s] }, {}, class: "sel" %>
        </div>
        <div class="field">
          <label class="label">ملاحظات داخلية — لا تظهر لأحد خارج الفريق</label>
          <%= f.text_area :admin_notes, class: "txt", rows: 5 %>
        </div>
        <%= f.submit "حفظ", class: "btn btn--primary btn--full pressable" %>
      <% end %>
    </div>

    <div class="card">
      <h2 class="card__title" style="margin-bottom:10px">رد سريع</h2>
      <div style="display:flex;flex-direction:column;gap:8px">
        <% if @lead.phone.present? %>
          <a class="btn btn--full pressable" href="https://wa.me/<%= @lead.phone.gsub(/\D/, "") %>" target="_blank" rel="noopener">واتساب</a>
          <a class="btn btn--full pressable" href="tel:<%= @lead.phone %>">اتصال</a>
        <% end %>
        <% if @lead.email.present? %>
          <a class="btn btn--full pressable" href="mailto:<%= @lead.email %>">بريد إلكتروني</a>
        <% end %>
      </div>
    </div>

    <div class="card">
      <%= render "admin/shared/delete_button", path: admin_lead_path(@lead), label: "حذف الطلب نهائيًا" %>
    </div>
  </aside>
</div>
