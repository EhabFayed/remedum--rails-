<% content_for :title, "المستخدمون" %>
<%= page_header "المستخدمون", "#{@users.size} حساب له وصول للوحة التحكم." do %>
  <a class="btn btn--primary pressable" href="<%= new_admin_user_path %>">+ مستخدم جديد</a>
<% end %>

<% if @pending.any? %>
  <div class="card" style="margin-bottom:18px;border-color:var(--green)">
    <h2 class="card__title" style="margin-bottom:6px">بانتظار الموافقة <span class="pill pill--hot"><%= @pending.size %></span></h2>
    <p class="hint" style="margin:0 0 14px">حسابات أُنشئت من صفحة التسجيل. اختر الصلاحية ثم وافق، أو ارفض الطلب لحذفه.</p>
    <div class="tablewrap"><div class="tablescroll">
      <table class="tbl">
        <thead><tr><th>الاسم</th><th>البريد</th><th>تاريخ الطلب</th><th>الصلاحية والموافقة</th></tr></thead>
        <tbody>
          <% @pending.each do |user| %>
            <tr>
              <td>
                <span class="tbl__title"><%= user.name %></span>
                <% if user.title_ar.present? %><p class="tbl__sub"><%= user.title_ar %></p><% end %>
              </td>
              <td class="lat" dir="ltr" style="color:var(--muted);font-size:12.5px"><%= user.email %></td>
              <td class="lat" style="font-size:11.5px;color:var(--faint)"><%= admin_date user.created_at %></td>
              <td>
                <div class="tbl__acts">
                  <%= form_with url: approve_admin_user_path(user), method: :patch, style: "display:flex;gap:8px;align-items:center" do |f| %>
                    <%= select_tag :role, options_for_select([["محرّر", "editor"], ["مدير", "admin"]], "editor"), class: "sel", style: "width:auto;min-width:7rem", "aria-label": "الصلاحية" %>
                    <%= f.submit "موافقة", class: "btn btn--sm btn--primary pressable" %>
                  <% end %>
                  <%= render "admin/shared/delete_button", path: admin_user_path(user), label: "رفض" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div></div>
  </div>
<% end %>

<div class="tablewrap"><div class="tablescroll">
  <table class="tbl">
    <thead><tr><th>الاسم</th><th>البريد</th><th>الصلاحية</th><th>آخر دخول</th><th>إجراءات</th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <a class="tbl__title" href="<%= edit_admin_user_path(user) %>"><%= user.name %></a>
            <% if user == current_user %><span class="pill pill--on" style="margin-inline-start:6px">أنت</span><% end %>
          </td>
          <td class="lat" dir="ltr" style="color:var(--muted);font-size:12.5px"><%= user.email %></td>
          <td><%= user.display_role %></td>
          <td class="lat" style="font-size:11.5px;color:var(--faint)"><%= admin_date user.last_login_at %></td>
          <td>
            <div class="tbl__acts">
              <a class="btn btn--sm pressable" href="<%= edit_admin_user_path(user) %>">تحرير</a>
              <% unless user == current_user %>
                <%= render "admin/shared/delete_button", path: admin_user_path(user), label: "حذف" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div></div>
