<div class="grid-2">
  <div class="field">
    <label class="label">الاسم <span class="req">*</span></label>
    <%= form.text_field :name, class: "inp" %>
  </div>
  <div class="field" dir="ltr">
    <label class="label">البريد الإلكتروني <span class="req">*</span></label>
    <%= form.email_field :email, class: "inp" %>
  </div>
</div>
<div class="grid-2">
  <div class="field">
    <label class="label">المسمى الوظيفي (عربي)</label>
    <%= form.text_field :title_ar, class: "inp", placeholder: "فريق الشؤون التنظيمية" %>
  </div>
  <div class="field" dir="ltr">
    <label class="label">Job title (English)</label>
    <%= form.text_field :title_en, class: "inp" %>
  </div>
</div>
<div class="field">
  <label class="label">الصلاحية</label>
  <%= form.select :role, [["محرّر — كل شيء عدا إدارة المستخدمين", "editor"], ["مدير — كل شيء", "admin"]], {}, class: "sel" %>
</div>
<div class="grid-2">
  <div class="field" dir="ltr">
    <label class="label">كلمة المرور<%= " — اتركها فارغة للإبقاء على الحالية" if form.object.persisted? %></label>
    <%= form.password_field :password, class: "inp", autocomplete: "new-password" %>
    <p class="hint" dir="rtl">١٠ أحرف على الأقل.</p>
  </div>
  <div class="field" dir="ltr">
    <label class="label">تأكيد كلمة المرور</label>
    <%= form.password_field :password_confirmation, class: "inp", autocomplete: "new-password" %>
  </div>
</div>
