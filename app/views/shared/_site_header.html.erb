<%# The one site header: inner pages (layouts/site) and both home pages render it.
    Homes style it through assets/css/site-header.css (generated from site.css). %>
<header class="site-header">
  <div class="site-header__inner">
    <a class="logo logo--brand" href="<%= locale_path("") %>">
      <span class="logo__mark"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19C5 9 11 4 20 4c0 9-5 15-15 15z"></path><path d="M5 19c3-6 6-9 10-11"></path></svg></span>
      <%# same lockup as the home pages: two-tone name + the other language beneath %>
      <span class="logo__stack"><% if I18n.locale == :ar %><span class="logo__text"><span class="logo__r">جذور</span> <span class="logo__u">الجمال</span></span><i class="logo__sub" lang="en" dir="ltr">BEAUTY ROOTS</i><% else %><span class="logo__text"><span class="logo__u">BEAUTY</span> <span class="logo__r">ROOTS</span></span><i class="logo__sub" lang="ar" dir="rtl">جذور الجمال</i><% end %></span>
    </a>
    <nav class="nav" aria-label="<%= t("site.actions.main_nav") %>">
      <button type="button" class="nav__search" data-search-open><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><span><%= t("site.search.placeholder") %></span></button>
      <ul class="nav__list">
        <% SiteHelper::NAV.each do |item| %>
        <li class="nav__item">
          <a class="nav__link<%= " is-active" if content_for(:nav_active).to_s == item[:key] %>" href="<%= locale_path(item[:path]) %>"><%= t("site.nav.#{item[:key]}") %><% if item[:items] %><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg><% end %></a>
          <% if item[:items] %>
          <div class="dropdown">
            <% item[:items].each do |(label_key, sub_path)| %>
            <a href="<%= locale_path(sub_path) %>"><%= t("site.nav.#{label_key}") %></a>
            <% end %>
          </div>
          <% end %>
        </li>
        <% end %>
      </ul>
    </nav>
    <div class="header__actions">
      <a class="btn btn--dark" href="<%= locale_path("medical/quote") %>"><%= t("site.actions.quote") %><span class="btn__circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8.5 7H17v8.5"></path></svg></span></a>
      <a class="wa-btn" href="<%= whatsapp_url %>" target="_blank" rel="noopener" aria-label="<%= t("site.actions.whatsapp") %>"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2zm4.8 13.9c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.6-.1 1.2z"></path></svg><span class="wa-btn__txt"><%= t("site.actions.whatsapp") %></span></a>
      <button type="button" class="hdr-search" data-search-open aria-label="<%= t("site.search.open") %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></button>
      <a class="lang-pill" href="<%= alt_locale_path %>" lang="<%= rtl? ? "en" : "ar" %>" dir="<%= rtl? ? "ltr" : "rtl" %>"><%= t("site.actions.lang_switch") %></a>
      <button class="burger" aria-label="<%= t("site.actions.menu") %>"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
