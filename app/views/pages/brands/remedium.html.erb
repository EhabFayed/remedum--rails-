<%# Face map from the home page (Oct 2026): same zones, points, colours and popup, all three products.
    Built by site.js from data-product="all"; the pack cards are left out because this page already shows the range above. %>
<section class="section--mint rm-fmap" id="facemap"><div class="container">

<div class="sec-head">
  <span class="eyebrow"><i></i><%= t('content.remedium_fmap_eyebrow') %></span>
  <h2 class="sec-title"><%= t('content.remedium_fmap_title') %></h2>
  <p class="sec-lead"><%= t('content.remedium_fmap_lead') %></p>
</div>
  <div class="hero-split rm-fmap__grid">
    <div class="facemap__stage">
      <div class="facemap__frame" data-product="all">
        <img class="facemap__photo" src="/assets/img/face-front.webp" width="880" height="1056" loading="lazy" alt="<%= t('content.brands_191') %> — ReMedium">
      </div>
    </div>
    <aside class="rm-fmap__side">
      <h3 class="rm-fmap__side-title"><%= t('content.remedium_fmap_side_title') %></h3>
      <p class="rm-fmap__side-text"><%= t('content.remedium_fmap_side_text') %></p>
      <ul class="rm-fmap__key">
        <% [['subq', 'sub-q', 'Sub-Q'], ['mid', 'mid', 'Mid'], ['fine', 'fine', 'Fine']].each do |key, slug, name| %>
          <li><a href="<%= locale_path("brands/remedium/#{slug}") %>" style="--c:var(--fm-<%= key %>)"><i aria-hidden="true"></i><b><bdi dir="ltr">ReMedium <%= name %></bdi></b><small><%= t("content.remedium_fmap_depth_#{key}") %></small></a></li>
        <% end %>
      </ul>
      <p class="rm-fmap__note"><%= t('content.remedium_fmap_note') %></p>
    </aside>
  </div>
</div></section>

<%# Compare section as a "hand of cards" (Oct 2026, from the client's reference image): one card per product.
    Desktop: scrolling into the section deals the cards from a stacked deck into a fan held from below,
    Mid raised in the middle (site.js sets --e from scroll position). Phones: the cards stack as you scroll.
    No ranking between products: the middle card is simply the middle density. %>
<% cmp_products = [
     { key: 'subq', slug: 'sub-q', name: 'Sub-Q', tag: 'brands_50', level: 'brands_58', areas: 'brands_52', dur: 'brands_53', from: 18, to: 24, needle: 'brands_59', depth: 84 },
     { key: 'mid',  slug: 'mid',   name: 'Mid',   tag: 'brands_26', level: 'brands_34', areas: 'brands_28', dur: 'brands_29', from: 12, to: 18, needle: 'brands_35', depth: 50 },
     { key: 'fine', slug: 'fine',  name: 'Fine',  tag: 'brands_1',  level: 'brands_9',  areas: 'brands_3',  dur: 'brands_4',  from: 9,  to: 12, needle: 'brands_10', depth: 27 }
   ] %>
<section class="cmph" id="compare">
  <span class="cmph__blob cmph__blob--a" aria-hidden="true"></span>
  <span class="cmph__blob cmph__blob--b" aria-hidden="true"></span>
  <svg class="cmph__leaves cmph__leaves--a" viewBox="0 0 160 240" aria-hidden="true"><path d="M80 236C78 170 82 110 96 40" fill="none" stroke="#3E6B4E" stroke-width="2.4" stroke-linecap="round"/><path d="M86 170C60 168 30 150 22 118c30-4 56 12 64 52z" fill="#5E8C67"/><path d="M88 132c22-8 48-34 50-66-28 6-48 30-50 66z" fill="#3E6B4E"/><path d="M91 96C70 88 54 62 58 34c22 12 34 36 33 62z" fill="#7FA582"/><path d="M84 206c26-4 52-24 58-52-30 2-52 22-58 52z" fill="#7FA582"/><path d="M95 44c6-16 18-30 34-36-2 18-14 32-34 36z" fill="#5E8C67"/></svg>
  <svg class="cmph__leaves cmph__leaves--b" viewBox="0 0 160 240" aria-hidden="true"><path d="M80 236C78 170 82 110 96 40" fill="none" stroke="#3E6B4E" stroke-width="2.4" stroke-linecap="round"/><path d="M86 170C60 168 30 150 22 118c30-4 56 12 64 52z" fill="#5E8C67"/><path d="M88 132c22-8 48-34 50-66-28 6-48 30-50 66z" fill="#3E6B4E"/><path d="M91 96C70 88 54 62 58 34c22 12 34 36 33 62z" fill="#7FA582"/><path d="M84 206c26-4 52-24 58-52-30 2-52 22-58 52z" fill="#7FA582"/><path d="M95 44c6-16 18-30 34-36-2 18-14 32-34 36z" fill="#5E8C67"/></svg>
  <div class="container">
    <div class="sec-head sec-head--center cmph__head">
      <span class="eyebrow"><i></i><%= t('content.remedium_compare_eyebrow') %></span>
      <h2 class="sec-title"><%= t('content.remedium_compare_title') %></h2>
      <p class="sec-lead"><%= t('content.remedium_compare_lead') %></p>
    </div>

    <div class="cmph__stage" data-cmp-hand>
      <% cmp_products.each_with_index do |p, i| %>
      <article class="cmpc" data-col="<%= p[:key] %>" style="--c:var(--fm-<%= p[:key] %>);--i:<%= i %>">
        <header class="cmpc__head">
          <span class="cmpc__pack"><img src="/assets/img/remedium-<%= p[:key] %>-pack-v.webp" width="400" height="631" loading="lazy" alt="ReMedium <%= p[:name] %>"></span>
          <span class="cmpc__title">
            <h3 class="cmpc__name"><bdi dir="ltr">ReMedium <b><%= p[:name] %></b></bdi></h3>
            <span class="cmpc__tag"><%= t("content.#{p[:tag]}").strip %></span>
          </span>
        </header>
        <dl class="cmpc__list">
          <div class="cmpc__row">
            <dt><%= t('content.brands_175') %></dt>
            <dd>
              <span class="cmpc__depth" style="--depth:<%= p[:depth] %>%" aria-hidden="true">
                <i class="cmpc__layer"><em><%= t('content.remedium_cmp_layer_epi') %></em></i>
                <i class="cmpc__layer"><em><%= t('content.remedium_cmp_layer_derm') %></em></i>
                <i class="cmpc__layer"><em><%= t('content.remedium_cmp_layer_sub') %></em></i>
                <span class="cmpc__needle"></span><span class="cmpc__dot"></span>
              </span>
              <span class="cmpc__level"><%= t("content.#{p[:level]}") %></span>
            </dd>
          </div>
          <div class="cmpc__row">
            <dt><%= t('content.brands_176') %></dt>
            <dd><ul class="cmpc__chips"><% t("content.#{p[:areas]}").split('·').map(&:strip).reject(&:blank?).each do |area| %><li><%= area %></li><% end %></ul></dd>
          </div>
          <div class="cmpc__row">
            <dt><%= t('content.brands_94') %></dt>
            <dd class="cmpc__dur">
              <b><%= t("content.#{p[:dur]}") %></b>
              <span class="cmpc__track"><span style="inset-inline-start:<%= p[:from] * 100 / 24.0 %>%;width:<%= (p[:to] - p[:from]) * 100 / 24.0 %>%"></span></span>
            </dd>
          </div>
          <div class="cmpc__row">
            <dt><%= t('content.brands_177') %></dt>
            <dd class="cmpc__needlerow"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 2 4 4M17 7l-9.5 9.5M14.5 4.5l5 5M3 21l3.5-3.5M9 12l3 3M6.5 14.5l3 3"/></svg><span><%= t("content.#{p[:needle]}") %></span></dd>
          </div>
        </dl>
        <a class="cmpc__go" href="<%= locale_path("brands/remedium/#{p[:slug]}") %>"><span><%= t('content.brands_96') %></span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8.5 7H17v8.5"></path></svg></a>
      </article>
      <% end %>
    </div>

    <%# identical for all three, so said once under the hand %>
    <ul class="cmph__shared">
      <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><%= t('content.brands_173') %>: <b class="lat" dir="ltr"><%= t('content.brands_174') %></b></span></li>
      <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><%= t('content.brands_152') %>: <b><%= t('content.brands_180') %></b></span></li>
      <li class="cmph__shared-note"><%= t('content.remedium_cmp_shared') %></li>
    </ul>
    <p class="foot-note cmph__note"><%= t('content.brands_197') %></p>
  </div>
</section>

<section class="section section--last"><div class="container">
  <div style="display:flex;flex-direction:column;align-items:center;gap:14px">
    <h3 style="font-family:var(--ff-d);font-size:19px;font-weight:800;text-align:center"><%= t('content.brands_160') %></h3>
    <div style="display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap">
