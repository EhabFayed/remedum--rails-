<section class="page-hero"><div class="container"><div class="page-hero__inner page-hero__inner--rm"><div class="hero-split">
  <div>

<div class="crumbs">
  <a href="<%= locale_path("") %>"><%= t('content.brands_76') %></a><span class="sep"><%= t('content.brands_80') %></span><a href="<%= locale_path("brands") %>"><%= t('content.brands_77') %></a><span class="sep"><%= t('content.brands_80') %></span><span class="here"><span class="lat" dir="ltr">ReMedium</span></span>
</div>
    <h1 class="page-title"><%= t('content.brands_124_html') %></h1>
    <p class="page-hero__lead"><%= t('content.brands_125') %></p>
    <%# revisions PDF (Oct 2026): only the exclusive-agency badge stays, shown as a badge rather than a chip %>
    <div class="rm-agency">
      <span class="rm-agency__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.3 7.5 9.5 4.4-1.2 7.5-4.9 7.5-9.5V6L12 3z"></path><path d="m8.8 12.2 2.2 2.2 4.4-4.6"></path></svg></span>
      <span class="rm-agency__text"><b><%= t('content.brands_126') %></b><small><%= t('content.remedium_hero_agency_sub') %></small></span>
    </div>
  </div>
  <div class="arch-media">
    <img src="/assets/img/brand-remedium.webp" alt="<%= t('content.brands_129') %>" style="height:380px">
    <span class="media-shade"></span>
  </div>
</div>
  <%# figures from remediumkorea.com (Oct 2026) + "present in 32 countries" from the revisions PDF %>
  <ul class="rm-stats">
    <% [['10+', 'years'], ['46+', 'partners'], ['85+', 'approvals'], ['50,000+', 'professionals'], ['32', 'countries']].each do |num, key| %>
      <li class="rm-stat"><b dir="ltr"><%= num %></b><span><%= t("content.remedium_hero_stat_#{key}") %></span></li>
    <% end %>
  </ul>
  <%# certification marks: SFDA first, then the order on remediumkorea.com (sfda.svg is a stand-in until the official mark is supplied) %>
  <div class="rm-certs">
    <span class="rm-certs__label"><%= t('content.remedium_hero_certs') %></span>
    <%# moving row: the set is rendered 4 times and the track slides by half its width, so the loop is seamless on any screen;
        only the first set is announced to screen readers %>
    <div class="rm-certs__marquee">
      <ul class="rm-certs__track">
        <% 4.times do |copy| %>
          <% [['sfda.svg', 'SFDA'], ['scpn.png', 'SCPN'], ['gmp-cosmetics.png', 'GMP'], ['iso.png', 'ISO'], ['gmp-mfds.png', 'GMP (MFDS)'], ['ce.png', 'CE'], ['usfda.png', 'US FDA'], ['mdsap.png', 'MDSAP'], ['kfda.png', 'KFDA'], ['cpnp.png', 'CPNP']].each do |file, name| %>
            <li<%= ' aria-hidden="true"'.html_safe if copy > 0 %>><img src="/assets/img/certs/<%= file %>" alt="<%= copy.zero? ? name : '' %>" title="<%= name %>"></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  </div>
</div></div></section>

