<% content_for :title, t('content.knowledge_title') %>
<% content_for :description, t('content.knowledge_description') %>
<% content_for :nav_active, 'knowledge' %>

<section class="page-hero"><div class="container"><div class="page-hero__inner" style="text-align:center;display:flex;flex-direction:column;align-items:center">

<div class="crumbs">
  <a href="<%= locale_path("") %>"><%= t('content.brands_76') %></a><span class="sep"><%= t('content.brands_80') %></span><span class="here"><%= t('content.pages_358') %></span>
</div>
  <h1 class="page-title"><%= t('content.pages_356') %></h1>
  <div class="search-pill" style="margin-top:20px">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
    <input type="search" placeholder="<%= t('content.pages_359') %>" aria-label="<%= t('content.pages_360') %>">
    <button type="button"><%= t('content.pages_360') %></button>
  </div>
  <div class="choice-chips" style="margin-top:18px;justify-content:center">
    <button type="button" class="cchip is-on"><%= t('content.pages_361') %></button>
    <button type="button" class="cchip"><%= t('content.pages_362') %></button>
    <button type="button" class="cchip"><%= t('content.pages_363') %></button>
    <button type="button" class="cchip"><%= t('content.pages_364') %></button>
    <button type="button" class="cchip"><%= t('content.pages_365') %></button>
  </div>
</div></div></section>

<section class="section"><div class="container">
  <div class="grid grid-3" style="gap:22px">
    <%= render "pages/knowledge_cards" %>
  </div>
</div></section>


<section class="section section--last"><div class="container">

<div class="sec-head">
  <span class="eyebrow"><i></i><%= t('content.pages_369') %></span>
