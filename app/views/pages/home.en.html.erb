          <h2 class="sec-title">Registration &amp; Support, Step by Step</h2>
          <p class="sec-lead">An experience designed for the medical sector &mdash; integrated with your facility&rsquo;s needs.</p>
        </div>

        <div class="steps-bar" id="stepsBar" style="grid-template-columns: repeat(6, 1fr)">
          <span class="steps-bar__line"></span>
          <button class="step-chip" type="button" style="--i: 0">
            <i></i>Step 1
          </button>
          <button class="step-chip is-active" type="button" style="--i: 1">
            <i></i>Step 2
          </button>
          <button class="step-chip" type="button" style="--i: 2">
            <i></i>Step 3
          </button>
          <button class="step-chip" type="button" style="--i: 3">
            <i></i>Step 4
