      ></span>
      <span class="process__flower process__flower--br" aria-hidden="true"
        ><svg viewBox="0 0 200 200"><use href="#i-flower" /></svg
      ></span>
      <div class="container">
        <div class="sec-head sec-head--center sec-head--light">
