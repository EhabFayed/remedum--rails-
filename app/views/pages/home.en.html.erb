    <!-- ================= 1. HERO + 2. IN NUMBERS ================= -->
    <section class="hero">
      <div class="hero__panel">
        <span class="dots dots--a"></span>
        <span class="dots dots--b"></span>
        <span class="checker"></span>
      </div>

      <div class="hero__inner">
        <!-- LEFT -->
        <div class="hero__left">
          <span class="hero__badge"
            ><svg class="ico ico--xs"><use href="#i-shield" /></svg> Authorized
            &amp; Fully SFDA-Compliant</span
          >

          <h1 class="hero__title">
            <span class="line">LICENSED DISTRIBUTOR</span>
            <span class="line">&amp; EXCLUSIVE AGENT</span>
            <span class="line"
              >FOR
              <span class="word-fx">
                <b style="--d: 0">R</b><b style="--d: 1">E</b
                ><b style="--d: 2">M</b><b style="--d: 3">E</b
                ><b style="--d: 4">D</b><b style="--d: 5">I</b
                ><b style="--d: 6">U</b><b style="--d: 7">M</b>
              </span>
            </span>
          </h1>

          <div class="hero__cta">
            <a href="/en/medical/quote/" class="btn btn--dark">
              <span>Request a Quote</span>
              <i class="btn__circle btn__circle--green"
                ><svg class="ico ico--sm"><use href="#i-arrow-ur" /></svg
              ></i>
            </a>
            <a href="#facemap" class="btn btn--ghost">
              <span>Ask Your Dermatologist</span>
              <i class="btn__circle btn__circle--outline"
                ><svg class="ico ico--sm"><use href="#i-arrow-ur" /></svg
              ></i>
            </a>
          </div>

          <!-- 2. Beauty Roots in numbers -->
          <div class="stats-card">
            <ul class="stats-card__list">
              <li>
                <strong
                  class="counter"
                  data-target="2016"
                  data-from="1996"
                  data-suffix=""
                  >2016</strong
                ><span>Year Established</span>
              </li>
              <li>
                <strong class="counter" data-target="6" data-suffix="">6</strong
                ><span>Global Brands Represented</span>
              </li>
              <li>
                <strong class="counter" data-target="13" data-suffix=""
                  >13</strong
                ><span>Administrative Regions Covered</span>
              </li>
              <li>
                <strong class="counter" data-target="14" data-suffix="+"
                  >14+</strong
                ><span>Years Regulatory Expertise</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- CENTER IMAGE -->
        <div class="hero__figure">
          <video src="/assets/video/hero.mp4" poster="/hero.jpg" autoplay muted loop playsinline></video>
        </div>

        <!-- RIGHT: trust quote (Two Audiences cards removed per client) -->
        <div class="hero__right">
          <div class="hero__quote" style="border-top: 0; padding-top: 0; margin-top: 0">
            <p>
              “Every product/unit we supply is fully registered, temperature-controlled,
              and traceable to its original batch and invoice from factory to
              clinic door.”
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= WHO WE ARE ================= -->
    <section class="about" id="about">
      <span class="side-word">ABOUT US</span>
      <div class="container">
        <div class="about__grid">
          <div class="about__media">
            <div class="collage">
              <div class="spin-badge">
                <svg
                  class="spin-badge__ring"
                  viewBox="0 0 100 100"
                  aria-hidden="true"
                >
                  <defs>
                    <path
                      id="spinPath"
                      d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0"
                    />
                  </defs>
                  <text>
                    <textPath href="#spinPath">
                      ReMedium &#8226; Authorized Distributor &#8226;
                    </textPath>
                  </text>
                </svg>
                <a
                  href="#products"
                  class="spin-badge__btn"
                  aria-label="Explore the product range"
                >
                  <svg class="ico ico--sm"><use href="#i-arrow-r" /></svg>
                </a>
              </div>

              <div class="collage__img collage__img--arch">
                <img
                  src="/assets/img/about-1.jpg"
                  alt="Licensed stock released under controlled conditions"
                />
              </div>

              <div class="collage__img collage__img--arch-alt">
                <img
                  src="/assets/img/about-2.jpg"
                  alt="Regulatory affairs lead"
                />
              </div>

              <div class="exp-badge">
                <span class="exp-badge__num"
                  ><b>14<sup>+</sup></b></span
                >
                <span class="exp-badge__txt">Regulatory<br />Experience</span>
              </div>
            </div>
          </div>

          <div class="about__content">
            <span class="eyebrow"
              ><svg class="ico ico--xs"><use href="#i-arr-in-r" /></svg> About
              Us <svg class="ico ico--xs"><use href="#i-arr-in-l" /></svg
            ></span>
            <h2 class="sec-title">
              Since 2016 &mdash; Presence &amp; Expertise <br />in the Medical Sector
            </h2>
            <div class="year">2016</div>
            <div class="about__body">
              <span class="about__leaf"
                ><svg class="ico"><use href="#i-leaf" /></svg
              ></span>
              <p>Since 2016, Beauty Roots has been active in the medical aesthetics and specialised medical-care products sector, building its portfolio of carefully selected brands and products to serve the needs of medical facilities in the Kingdom. Today, as the authorized distributor and exclusive agent for ReMedium, we extend our services from product supply to support, distribution, and follow-up with medical facilities across all regions of Saudi Arabia.</p>
            </div>
            <div class="about__cols">
              <div class="about__col">
                <h4>Our Mission</h4>
                <p>
                  To provide the Saudi healthcare sector with scientifically
                  proven aesthetic solutions from accredited global
                  manufacturers, delivered through a fully compliant supply
                  chain with continuous clinical and technical support.
                </p>
              </div>
              <div class="about__col">
                <h4>Our Vision</h4>
                <p>
                  To be the most trusted and reassuring benchmark for clinics
                  and medical practitioners across the Kingdom, delivering
                  uncompromised regulatory compliance and patient safety.
                </p>
              </div>
            </div>
            <a href="/en/company/about/" class="btn btn--green btn--sm">
              <span>More About Us</span>
              <i class="btn__circle btn__circle--white btn__circle--sm"
                ><svg class="ico ico--xs"><use href="#i-arrow-r" /></svg
              ></i>
            </a>
          </div>
        </div>
      </div>
    </section>

