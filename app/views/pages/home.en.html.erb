                />
              </div>
            </div>
          </article>
          <article class="step is-active" style="--i: 1">
            <h4 class="step__title">Open Your Account</h4>
            <div class="step__media">
              <div class="step__img step__img--pill">
                <img
                  src="/assets/img/step-account.jpg"
                  alt="Facility documents"
                />
                <span class="step__cap">Provide your facility details and the required documents.</span>
              </div>
              <div class="step__img step__img--circle">
                <img
                  src="/assets/img/step-account.jpg"
                  alt=""
                />
              </div>
            </div>
          </article>
          <article class="step" style="--i: 2">
            <h4 class="step__title">Place Your Order</h4>
            <div class="step__media">
              <div class="step__img step__img--pill">
                <img
                  src="/assets/img/step-purchase.jpg"
                  alt="Preparing the order"
                />
                <span class="step__cap">Choose the required products and complete the purchase process.</span>
              </div>
              <div class="step__img step__img--circle">
                <img
                  src="/assets/img/step-purchase.jpg"
                  alt=""
                />
              </div>
            </div>
          </article>
          <article class="step" style="--i: 3">
            <h4 class="step__title">Shipping &amp; Delivery</h4>
            <div class="step__media">
              <div class="step__img step__img--pill">
                <img
                  src="/assets/img/step-shipping.jpg"
                  alt="Shipping and delivery"
                />
