              </div>
              <div class="step__img step__img--circle">
                <img
                  src="/assets/img/step-shipping.jpg"
                  alt=""
                />
              </div>
            </div>
          </article>
          <article class="step" style="--i: 4">
            <h4 class="step__title">Training &amp; Support</h4>
            <div class="step__media">
              <div class="step__img step__img--pill">
                <img
                  src="/assets/img/step-training.jpg"
                  alt="Training and support"
                />
                <span class="step__cap">We provide training materials and product-related technical support.</span>
              </div>
              <div class="step__img step__img--circle">
                <img
                  src="/assets/img/step-training.jpg"
                  alt=""
                />
              </div>
            </div>
          </article>
          <article class="step" style="--i: 5">
            <h4 class="step__title">Follow-Up</h4>
            <div class="step__media">
              <div class="step__img step__img--pill">
                <img
                  src="/assets/img/step-followup.jpg"
                  alt="Ongoing follow-up"
                />
                <span class="step__cap">We follow up on your facility&rsquo;s needs and reordering to keep supply continuous.</span>
              </div>
              <div class="step__img step__img--circle">
                <img
                  src="/assets/img/step-followup.jpg"
                  alt=""
                />
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= 10. KNOWLEDGE CENTER ================= -->
    <section class="blog" id="knowledge">
      <div class="container">
        <div class="sec-head sec-head--center">
          <span class="eyebrow"
            ><svg class="ico ico--xs"><use href="#i-arr-in-r" /></svg> Knowledge
            Center <svg class="ico ico--xs"><use href="#i-arr-in-l" /></svg
          ></span>
          <h2 class="sec-title">Insights &amp; Clinical Knowledge</h2>
        </div>

        <div class="blog__grid">
          <% @posts.each do |post| %>
          <% cover = post.cover_for(I18n.locale) %>
          <article class="post">
            <div class="post__img">
              <% if cover %>
              <img src="<%= cover[:url] %>" alt="<%= cover[:alt] %>" loading="lazy" />
              <% end %>
              <span class="post__date"><b><%= (post.published_at || post.created_at).day %></b><small><%= l((post.published_at || post.created_at).to_date, format: "%B") %></small></span>
              <a href="<%= post.path_for(I18n.locale) %>" class="post__btn" aria-label="<%= post.title_for(I18n.locale) %>"
                ><svg class="ico ico--sm"><use href="#i-arrow-ur" /></svg
              ></a>
            </div>
            <div class="post__meta">
              <% if post.category %><span class="post__cat"><%= post.category.name_for(I18n.locale) %></span><% end %>
              <span class="post__author"><%= post.byline_for(I18n.locale) %></span>
            </div>
            <h3 class="post__title">
              <a href="<%= post.path_for(I18n.locale) %>"><%= post.title_for(I18n.locale) %></a>
            </h3>
          </article>
          <% end %>
        </div>
      </div>
    </section>

