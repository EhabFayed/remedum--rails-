<%# Knowledge page — "three tracks" review section, edited from /admin/review_tracks %>
<% tracks = ReviewTrack.live.ordered.to_a %>
<% if tracks.any? %>
<% loc = I18n.locale
   star = '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.5 7 .8-5.2 4.8 1.4 7L12 17.5 5.8 21l1.4-7L2 9.3l7-.8z"></path></svg>' %>
<section class="section section--last"><div class="container">

<div class="sec-head">
  <span class="eyebrow"><i></i><%= ReviewTrack.heading(:eyebrow, loc) || t('content.pages_369') %></span>
  <h2 class="sec-title"><%= ReviewTrack.heading(:title, loc) || t('content.pages_370') %></h2>

</div>
  <div class="grid grid-3">
<% tracks.each do |track| %>
    <div class="card">
      <h4 class="card__title"><%= track.title_for(loc) %></h4>
      <% if track.body_for(loc).present? %><p><%= track.body_for(loc) %></p><% end %>
<% case track.kind
   when "quote" %>
      <div class="quote-card">
        <p><%= track.note_for(loc) %></p>
        <span class="who"><% if track.image_url.present? %><img src="<%= track.image_url %>" alt=""><% end %><b><%= track.caption_for(loc) %></b></span>
      </div>
<% when "rating" %>
      <div class="stars" style="margin-top:14px"><%= raw(star * 5) %><% if track.link_url.present? %><a href="<%= track.link_url %>" target="_blank" rel="noopener" style="font-size:12px;font-weight:700;color:var(--green-600)"><%= track.note_for(loc) %> <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 5h5v5"></path><path d="M19 5l-8 8"></path><path d="M9 5H5v14h14v-4"></path></svg></a><% end %></div>
<% when "badge" %>
      <% if track.note_for(loc).present? %><div style="margin-top:14px"><span class="chip"><%= track.note_for(loc) %></span></div><% end %>
<% end %>
    </div>
<% end %>
  </div>
</div></section>
<% end %>
