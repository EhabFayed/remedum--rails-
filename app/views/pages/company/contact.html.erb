<%# "Request a quote" — the form that used to be its own page (medical/quote); site.js posts it to /leads %>
<section class="section" id="quote" style="scroll-margin-top:96px"><div class="container">
  <div class="sec-head">
    <span class="eyebrow"><i></i><%= t('content.pages_84') %></span>
