<% content_for :title, t('content.medical_quote_title') %>
<% content_for :description, t('content.medical_quote_description') %>
<% content_for :nav_active, 'medical' %>


<section class="page-hero"><div class="container"><div class="page-hero__inner">

<div class="crumbs">
  <a href="<%= locale_path("") %>"><%= t('content.brands_76') %></a><span class="sep"><%= t('content.brands_80') %></span><a href="<%= locale_path("medical/evidence") %>"><%= t('content.pages_212') %></a><span class="sep"><%= t('content.brands_80') %></span><span class="here"><%= t('content.pages_311') %></span>
</div>
  <h1 class="page-title"><%= t('content.pages_313') %></h1>

</div></div></section>

<section class="section section--last"><div class="container">
  <div class="grid" style="grid-template-columns:1.3fr .7fr;gap:18px;align-items:start">
    <form class="form-card" data-quote-form novalidate>
      <div data-form-body>

        <div class="form-grid">

<div class="field">
  <label for="name"><%= t('content.pages_316') %> <span class="req">*</span></label>
  <input type="text" id="name" name="name" placeholder="<%= t('content.pages_317') %>" required>
</div>
          <div class="field">
            <label><%= t('content.pages_318') %> <span class="req">*</span></label>
            <div class="choice-chips" data-field="facility_type">
              <button type="button" class="cchip is-on"><%= t('content.pages_319') %></button>
              <button type="button" class="cchip"><%= t('content.pages_320') %></button>
              <button type="button" class="cchip"><%= t('content.pages_321') %></button>
              <button type="button" class="cchip"><%= t('content.pages_322') %></button>
            </div>
          </div>

<div class="field">
  <label for="facility"><%= t('content.pages_323') %> <span class="req">*</span></label>
  <input type="text" id="facility" name="facility" placeholder="<%= t('content.pages_324') %>" required>
</div>

<div class="field">
  <label for="city"><%= t('content.pages_325') %> <span class="req">*</span></label>
  <input type="text" id="city" name="city" placeholder="<%= t('content.pages_326') %>" required>
</div>

<div class="field">
  <label for="phone"><%= t('content.pages_327') %> <span class="req">*</span></label>
  <input type="tel" id="phone" name="phone" placeholder="+966 5X XXX XXXX" required>
</div>

<div class="field">
  <label for="email"><%= t('content.pages_90') %> <span class="req">*</span></label>
  <input type="email" id="email" name="email" placeholder="name@clinic.sa" required>
</div>
          <div class="field field--wide">
            <label><%= t('content.pages_328') %> <span class="req">*</span></label>
            <div class="choice-chips" data-multi data-field="products">
              <button type="button" class="cchip">ReMedium® Fine</button>
              <button type="button" class="cchip">ReMedium® Mid</button>
              <button type="button" class="cchip">ReMedium® Sub-Q</button>
              <button type="button" class="cchip"><%= t('content.pages_329') %></button>
              <button type="button" class="cchip"><%= t('content.pages_330') %></button>
            </div>
          </div>
        </div>
        <br>
        <div class="form-grid">
          <div class="field">
            <label><%= t('content.pages_332') %></label>
            <div class="choice-chips" data-field="volume">
              <button type="button" class="cchip"><%= t('content.pages_333') %></button>
              <button type="button" class="cchip"><%= t('content.pages_334') %></button>
              <button type="button" class="cchip"><%= t('content.pages_335') %></button>
            </div>
          </div>
          <div class="field">
            <label><%= t('content.pages_336') %></label>
            <div class="choice-chips" data-field="existing">
              <button type="button" class="cchip"><%= t('content.pages_337') %></button>
              <button type="button" class="cchip"><%= t('content.pages_338') %></button>
            </div>
          </div>
          <label class="checkbox-row field--wide"><input type="checkbox" name="visit"><%= t('content.pages_339') %></label>

<div class="field field--wide">
  <label for="notes"><%= t('content.pages_340') %></label>
  <textarea id="notes" name="notes" placeholder="<%= t('content.pages_341') %>"></textarea>
</div>
        </div>
        <div style="margin-top:24px;display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--line);padding-top:22px">
          <label class="checkbox-row"><input type="checkbox" data-consent><%= t('content.pages_342') %> <a href="<%= locale_path("legal/privacy") %>" style="color:var(--green-600);font-weight:700"><%= t('content.pages_343') %></a> <%= t('content.pages_344') %></label>
          <label class="checkbox-row"><input type="checkbox" name="eligibility"><%= t('content.pages_345') %></label>
          <div class="honeypot" aria-hidden="true">
            <label><%= t('content.pages_346') %><input type="text" name="company_website" tabindex="-1" autocomplete="off"></label>
          </div>
          <p data-form-error hidden style="font-size:12.5px;line-height:1.8"></p>
          <div><button type="submit" class="btn btn--green"><%= t('content.pages_347') %><span class="btn__circle"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 17L7 7"></path><path d="M7 14V7h7"></path></svg></span></button></div>
        </div>
      </div>
      <div class="thanks" data-form-thanks hidden>
        <b><%= t('content.pages_348') %></b>
        <p><%= t('content.pages_349') %></p>
      </div>
    </form>
  </div>
</div></section>

