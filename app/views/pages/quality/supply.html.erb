<% content_for :title, t('content.quality_supply_title') %>
<% content_for :description, t('content.quality_supply_description') %>
<% content_for :nav_active, 'quality' %>

<%# "Quality & supply chain" (client copy, Oct 2026): what used to be spread over the quality/compliance
    and supply pages, without the repetition. 01 quality management as a four-slide slider (site.js,
    [data-qslider]) -> 02 the seven-stage product journey (zig-zag timeline, a single column on phones)
    -> 03 storage & transport (the warehouse photo, GSP / GDP) -> 04 traceability & response + contact. %>

<section class="page-hero"><div class="container"><div class="page-hero__inner">
<div class="crumbs">
  <a href="<%= locale_path("") %>"><%= t('content.brands_76') %></a><span class="sep"><%= t('content.brands_80') %></span><a href="<%= locale_path("quality/certifications") %>"><%= t('site.nav.quality') %></a><span class="sep"><%= t('content.brands_80') %></span><span class="here"><%= t('content.quality_supply_title') %></span>
</div>
  <h1 class="page-title"><%= t('content.qs_hero_title') %></h1>
  <p class="page-hero__lead"><%= t('content.qs_hero_text') %></p>
</div></div></section>

<%# 01 quality & compliance management: four slides. Native scroll-snap track (a swipe works with no JS);
    site.js adds the arrows, dots, counter and keyboard arrows. No autoplay. %>
<% slide_icons = {
     1 => '<path d="M6 2h8l4 4v16H6z"></path><path d="M14 2v4h4"></path><path d="M9 12h6M9 16h6"></path>',
     2 => '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path><circle cx="12" cy="12" r="3"></circle>',
     3 => '<path d="M3 7l9-4 9 4v10l-9 4-9-4z"></path><path d="M3 7l9 4 9-4M12 11v10"></path>',
     4 => '<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"></path><path d="M9 12l2 2 4-4"></path>'
   } %>
<% slide_imgs = %w[why-sfda why-quality why-training quality-compliance] %>
<section class="section"><div class="container">
  <div class="sec-head">
    <span class="eyebrow"><i></i><span class="cert-step">01</span> <%= t('content.qs_s1_eyebrow') %></span>
    <h2 class="sec-title"><%= t('content.qs_s1_title') %></h2>
    <p class="sec-lead"><%= t('content.qs_s1_text') %></p>
  </div>
  <div class="qslider" data-qslider>
    <div class="qslider__track" tabindex="0" aria-roledescription="carousel" aria-label="<%= t('content.qs_s1_title') %>">
      <% slide_imgs.each_with_index do |img, i| %>
      <% n = i + 1 %>
      <article class="qslider__slide<%= ' is-active' if i.zero? %>" aria-roledescription="slide" aria-label="<%= n %> / <%= slide_imgs.size %>">
        <div class="qslider__media">
          <img src="/assets/img/<%= img %>.webp" alt="" loading="<%= i.zero? ? 'eager' : 'lazy' %>" decoding="async">
          <span class="qslider__num" aria-hidden="true"><%= format('%02d', n) %></span>
        </div>
        <div class="qslider__body">
          <span class="icon-tile icon-tile--sm"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= slide_icons[n].html_safe %></svg></span>
          <h3 class="qslider__h"><%= t("content.qs_slide_#{n}_title") %></h3>
          <p class="qslider__p"><%= t("content.qs_slide_#{n}_text") %></p>
        </div>
      </article>
      <% end %>
    </div>
    <div class="qslider__nav">
      <button class="qslider__arrow" type="button" data-dir="-1" aria-label="<%= t('content.qs_prev') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
      <div class="qslider__dots" role="tablist" aria-label="<%= t('content.qs_s1_title') %>">
        <% slide_imgs.each_with_index do |_, i| %>
        <button class="qslider__dot<%= ' is-active' if i.zero? %>" type="button" role="tab" aria-selected="<%= i.zero? %>" aria-label="<%= t("content.qs_slide_#{i + 1}_title") %>"></button>
        <% end %>
      </div>
      <span class="qslider__count" dir="ltr"><b>01</b> / <%= format('%02d', slide_imgs.size) %></span>
      <button class="qslider__arrow" type="button" data-dir="1" aria-label="<%= t('content.qs_next') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></button>
    </div>
  </div>
</div></section>

<%# 02 the product journey: seven stages on a zig-zag timeline %>
<section class="section--mint"><div class="container">
  <div class="sec-head">
    <span class="eyebrow"><i></i><span class="cert-step">02</span> <%= t('content.qs_s2_eyebrow') %></span>
    <h2 class="sec-title"><%= t('content.qs_s2_title') %></h2>
    <p class="sec-lead"><%= t('content.qs_s2_text') %></p>
  </div>
  <ol class="journey">
    <% (1..7).each do |n| %>
    <li class="journey__item">
      <span class="journey__dot" aria-hidden="true"></span>
      <div class="card journey__card">
        <span class="num"><%= format('%02d', n) %></span>
        <h4 class="card__title"><%= t("content.qs_step_#{n}_title") %></h4>
        <p><%= t("content.qs_step_#{n}_text") %></p>
      </div>
    </li>
    <% end %>
  </ol>
</div></section>

<%# 03 storage & transport: the licensed warehouse photo, GSP and GDP %>
<section class="section" id="storage" style="scroll-margin-top:96px"><div class="container">
  <div class="sec-head">
    <span class="eyebrow"><i></i><span class="cert-step">03</span> <%= t('content.qs_s3_eyebrow') %></span>
    <h2 class="sec-title"><%= t('content.qs_s3_title') %></h2>
    <p class="sec-lead"><%= t('content.qs_s3_text') %></p>
  </div>
  <div class="grid q-storage" style="grid-template-columns:.9fr 1.1fr;gap:18px;align-items:stretch">
    <div class="arch-media arch-media--card q-storage__photo">
      <img src="/assets/img/quality-warehouse-photo.webp" alt="<%= t('content.qs_photo_alt') %>">
      <span class="media-shade"></span>
    </div>
    <div class="q-storage__cards">
      <div class="card q-practice">
        <b class="cert-code lat" dir="ltr">GSP</b>
        <div>
          <h4 class="card__title"><%= t('content.qs_gsp_title') %></h4>
          <p><%= t('content.qs_gsp_text') %></p>
        </div>
      </div>
      <div class="card q-practice">
        <b class="cert-code lat" dir="ltr">GDP</b>
        <div>
          <h4 class="card__title"><%= t('content.qs_gdp_title') %></h4>
          <p><%= t('content.qs_gdp_text') %></p>
        </div>
      </div>
    </div>
  </div>
</div></section>

<%# 04 traceability & response %>
<section class="section section--last"><div class="container">
  <div class="sec-head">
    <span class="eyebrow"><i></i><span class="cert-step">04</span> <%= t('content.qs_s4_eyebrow') %></span>
  </div>
  <div class="dark-strip q-cta">
    <div class="q-cta__body">
      <h3><%= t('content.qs_s4_title') %></h3>
      <p><%= t('content.qs_s4_text') %></p>
    </div>
    <a class="btn btn--white q-cta__btn" href="<%= locale_path("company/contact") %>"><%= t('content.qs_s4_btn') %><span class="btn__circle"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8.5 7H17v8.5"></path></svg></span></a>
  </div>
</div></section>
