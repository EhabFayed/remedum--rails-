<% content_for :title, t('content.quality_certifications_title') %>
<% content_for :description, t('content.quality_certifications_description') %>
<% content_for :nav_active, 'quality' %>


<section class="page-hero"><div class="container"><div class="page-hero__inner">

<div class="crumbs">
  <a href="<%= locale_path("") %>"><%= t('content.brands_76') %></a><span class="sep"><%= t('content.brands_80') %></span><a href="<%= locale_path("quality/compliance") %>"><%= t('content.pages_104') %></a><span class="sep"><%= t('content.brands_80') %></span><span class="here"><%= t('content.pages_182') %></span>
</div>
  <h1 class="page-title"><%= t('content.pages_182') %></h1>


</div></div></section>

<%# Grouped certifications (client revisions, Oct 2026): Saudi approvals -> ReMedium -> the other brands
    (then the shared manufacturer). Records, logos and "pending" flags are managed in Admin > Certifications;
    nothing here describes a certificate until it has been matched against the documents. %>
<% saudi = @certifications.select { |c| c.group_key == "saudi" } %>
<% remedium = @certifications.select { |c| c.group_key == "remedium" } %>
<% brands = @certifications.select { |c| c.group_key == "brand" }.group_by(&:brand_name) %>
<% makers = @certifications.select { |c| c.group_key == "manufacturer" }.group_by(&:brand_name) %>
<% mark = ->(c, size = "") { c.logo_path.present? ? image_tag(c.logo_path, alt: c.code, class: "cert-logo #{size}", loading: "lazy") : content_tag(:b, c.code, class: "cert-code #{size}", dir: "ltr") } %>

<%# 01 Saudi %>
<section class="section cert-group"><div class="container">
  <div class="sec-head">
    <span class="eyebrow"><i></i><span class="cert-step">01</span> <%= t('content.certs_saudi_eyebrow') %></span>
  </div>
  <% saudi.each do |c| %>
  <div class="dark-strip cert-saudi">
    <b class="lat cert-saudi__mark" dir="ltr"><%= c.code %></b>
    <div>
      <h3 style="font-size:19px"><%= t('content.pages_187') %></h3>
      <p><%= t('content.pages_188') %></p>
      <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
        <span class="chip chip--dark"><%= t('content.pages_189_html') %></span>
        <span class="chip chip--dark"><%= t('content.pages_190_html') %></span>
      </div>
    </div>
  </div>
  <% end %>
</div></section>

<%# 02 ReMedium %>
<section class="section cert-group"><div class="container">
  <div class="sec-head">
    <span class="eyebrow"><i></i><span class="cert-step">02</span> <%= t('content.certs_remedium_eyebrow') %></span>
    <h2 class="sec-title"><%= t('content.certs_remedium_title_html') %></h2>
  </div>
  <%# moving row, like the certification strip on the ReMedium page: the set is rendered 4 times and the
      track slides by half its width so the loop is seamless; only the first set is read by screen readers %>
  <div class="rm-certs__marquee cert-marquee">
    <ul class="rm-certs__track cert-tiles--track">
      <% 4.times do |copy| %>
      <% remedium.each do |c| %>
      <li class="cert-tile"<%= ' aria-hidden="true"'.html_safe if copy > 0 %>>
        <span class="cert-tile__mark"><%= mark.call(c) %></span>
        <b class="cert-tile__code" dir="ltr"><%= c.code %></b>
        <span class="cert-tile__name"><%= c.name_for(I18n.locale) %></span>
      </li>
      <% end %>
      <% end %>
    </ul>
  </div>
</div></section>

<%# 03 the other brands, then their shared manufacturer %>
<section class="section cert-group"><div class="container">
  <div class="sec-head">
    <span class="eyebrow"><i></i><span class="cert-step">03</span> <%= t('content.certs_brands_eyebrow') %></span>
    <h2 class="sec-title"><%= t('content.certs_brands_title') %></h2>
    <p class="sec-lead"><%= t('content.certs_brands_lead') %></p>
  </div>
  <div class="cert-brands">
    <% %w[HA\ Filler Hairont OVDs].each do |brand| %>
    <% list = brands[brand] || [] %>
    <article class="card cert-brand">
      <h3 class="cert-brand__name lat" dir="ltr"><%= brand %></h3>
      <% if list.any? %>
      <ul class="cert-brand__list">
        <% list.each do |c| %>
        <li>
          <span class="cert-brand__mark"><%= mark.call(c, "is-sm") %></span>
          <span class="cert-brand__text"><% if c.logo_path.present? %><b dir="ltr"><%= c.code %></b><% end %><small><%= c.name_for(I18n.locale) %></small></span>
          <% if c.pending? %><% end %>
        </li>
        <% end %>
      </ul>
      <% else %>
      <% end %>
    </article>
    <% end %>
  </div>

  <% makers.each do |maker, list| %>
  <div class="cert-maker">
    <div class="cert-maker__head">
      <span class="eyebrow"><i></i><%= t('content.certs_maker_eyebrow') %></span>
      <h3 class="cert-maker__name lat" dir="ltr"><%= maker %></h3>
      <p class="cert-maker__text"><%= t('content.certs_maker_text') %></p>
    </div>
    <ul class="cert-maker__list">
      <% list.each do |c| %>
      <li><span class="cert-brand__mark"><%= mark.call(c, "is-sm") %></span><span class="cert-brand__text"><% if c.logo_path.present? %><b dir="ltr"><%= c.code %></b><% end %><small><%= c.name_for(I18n.locale) %></small></span><% if c.pending? %><% end %></li>
      <% end %>
    </ul>
  </div>
  <% end %>
</div></section>

