<%# Accreditation rows — the same records the home strip shows, with the full
    name and the practical meaning the dedicated page has room for.
    A fixed 4:8 column ratio keeps every description starting on the same
    line; `auto` sizing let each row set its own width and looked ragged. %>
<div class="cert-rows">
  <% @certifications.each do |cert| %>
    <div class="card cert-row">
      <div class="cert-row__code">
        <b class="cert-row__mark" dir="ltr"><%= cert.code %></b>
        <% if cert.full_name.present? %>
          <span class="cert-row__full" dir="ltr"><%= cert.full_name %></span>
        <% end %>
      </div>
      <div class="cert-row__body">
        <b class="cert-row__title"><%= cert.name_for(I18n.locale) %></b>
        <% if cert.meaning_for(I18n.locale).present? %>
          <p class="cert-row__text"><%= cert.meaning_for(I18n.locale) %></p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
