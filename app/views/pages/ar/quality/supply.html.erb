        <p style="font-size:13px">توصيل مباشر عبر مندوبينا.</p>
      </div>
    </div>
    <div class="card" style="display:flex;align-items:center;gap:14px">
      <span class="icon-tile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h12v11H2z"></path><path d="M14 10h4l3 3v4h-7z"></path><circle cx="6.5" cy="18.5" r="1.8"></circle><circle cx="16.5" cy="18.5" r="1.8"></circle></svg></span>
