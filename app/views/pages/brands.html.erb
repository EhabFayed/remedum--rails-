      <div style="display:flex;flex-wrap:wrap;gap:8px"><span class="chip chip--dark"><span class="lat" dir="ltr">SFDA</span></span><span class="chip chip--dark"><span class="lat" dir="ltr">MFDS</span></span><span class="chip chip--dark"><span class="lat" dir="ltr">GMP</span></span><span class="chip chip--dark"><span class="lat" dir="ltr">MDSAP</span></span><span class="chip chip--dark"><span class="lat" dir="ltr">ISO 13485</span></span><span class="chip chip--dark"><span class="lat" dir="ltr">CE</span></span></div>
