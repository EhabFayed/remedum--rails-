# Development image — used by docker-compose.yml. The production image stays
# in ./Dockerfile (Kamal/registry deploys). Code is bind-mounted at /app, so
# edits on the host apply live without rebuilding; rebuild only when the
# Gemfile changes.
ARG RUBY_VERSION=3.2.10
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /app

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl git libjemalloc2 libpq-dev libvips libyaml-dev \
      pkg-config postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle"

COPY Gemfile Gemfile.lock ./
RUN bundle install

# Match the host user's uid so files written into the bind mount (log/, tmp/)
# stay editable outside the container.
ARG UID=1001
ARG GID=1001
RUN groupadd -g "$GID" dev && useradd -u "$UID" -g "$GID" -m dev && \
    chown -R "$UID:$GID" "$BUNDLE_PATH"
USER dev

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
